<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet id="1" author="prasad">

        <createTable tableName="message_requests">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="from_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="to_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="message_requests"
                baseColumnNames="from_user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_mr_from"/>

        <addForeignKeyConstraint
                baseTableName="message_requests"
                baseColumnNames="to_user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_mr_to"/>

        <createIndex tableName="message_requests" indexName="idx_mr_to">
            <column name="to_user_id"/>
        </createIndex>

        <createIndex tableName="message_requests" indexName="idx_mr_from">
            <column name="from_user_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
