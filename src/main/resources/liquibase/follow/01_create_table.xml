<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet id="1" author="prasad">

        <createTable tableName="follows">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="follower_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="following_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addUniqueConstraint
                tableName="follows"
                columnNames="follower_id, following_id"
                constraintName="uk_follow_unique"/>

        <addForeignKeyConstraint
                baseTableName="follows"
                baseColumnNames="follower_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_follows_follower"/>

        <addForeignKeyConstraint
                baseTableName="follows"
                baseColumnNames="following_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_follows_following"/>

        <createIndex tableName="follows" indexName="idx_follows_follower">
            <column name="follower_id"/>
        </createIndex>

        <createIndex tableName="follows" indexName="idx_follows_following">
            <column name="following_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
